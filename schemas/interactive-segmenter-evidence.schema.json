{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactive-segmenter-evidence.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "producer",
    "records",
    "screenshots",
    "denominators",
    "blocker"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "status": { "enum": ["completed", "partial", "blocked"] },
    "producer": {
      "type": "object",
      "required": ["eventCount", "ledgerSha256", "finalEventHash"],
      "properties": {
        "eventCount": { "type": "integer", "minimum": 0 },
        "ledgerSha256": { "$ref": "#/$defs/digest" },
        "finalEventHash": { "$ref": "#/$defs/digest" }
      }
    },
    "records": { "type": "array" },
    "screenshots": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/screenshot" }
    },
    "denominators": {
      "type": "object",
      "required": [
        "routeDeviceRuns",
        "consoleBefore",
        "consoleAfter",
        "networkBefore",
        "networkAfter",
        "screenshots"
      ],
      "properties": {
        "routeDeviceRuns": {
          "type": "object",
          "required": ["completed", "blocked", "notRun", "expected", "rows"],
          "properties": {
            "completed": { "type": "integer", "minimum": 0, "maximum": 10 },
            "blocked": { "type": "integer", "minimum": 0, "maximum": 10 },
            "notRun": { "type": "integer", "minimum": 0, "maximum": 10 },
            "expected": { "const": 10 },
            "rows": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": { "$ref": "#/$defs/routeDeviceRow" }
            }
          }
        },
        "consoleBefore": { "$ref": "#/$defs/tenDenominator" },
        "consoleAfter": { "$ref": "#/$defs/tenDenominator" },
        "networkBefore": { "$ref": "#/$defs/tenDenominator" },
        "networkAfter": { "$ref": "#/$defs/tenDenominator" },
        "screenshots": {
          "type": "object",
          "required": ["accepted", "blocked", "expected"],
          "properties": {
            "accepted": { "type": "integer", "minimum": 0, "maximum": 20 },
            "blocked": { "type": "integer", "minimum": 0, "maximum": 20 },
            "expected": { "const": 20 }
          }
        }
      }
    },
    "blocker": { "type": ["object", "null"] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tenDenominator": {
      "type": "object",
      "required": ["completed", "expected"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 10 },
        "expected": { "const": 10 }
      }
    },
    "routeDeviceRow": {
      "type": "object",
      "required": ["route", "device", "status"],
      "properties": {
        "route": { "enum": ["overview", "basics", "practical", "wild", "multi"] },
        "device": { "enum": ["desktop", "mobile"] },
        "status": { "enum": ["completed", "blocked", "notRun"] }
      }
    },
    "screenshot": {
      "type": "object",
      "required": [
        "route",
        "device",
        "theme",
        "path",
        "expectedViewport",
        "image",
        "bytes",
        "sha256"
      ],
      "properties": {
        "route": { "enum": ["overview", "basics", "practical", "wild", "multi"] },
        "device": { "enum": ["desktop", "mobile"] },
        "theme": { "enum": ["light", "dark"] },
        "path": { "type": "string", "pattern": "^evidence/screenshots/.+\\.webp$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "image": { "$ref": "#/$defs/dimensions" },
        "expectedViewport": {
          "allOf": [
            { "$ref": "#/$defs/dimensions" },
            { "type": "object", "required": ["dpr"], "properties": { "dpr": { "const": 1 } } }
          ]
        }
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
