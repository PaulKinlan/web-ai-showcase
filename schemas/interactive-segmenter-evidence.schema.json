{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactive-segmenter-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "producer",
    "exactRuntime",
    "stages",
    "artifact",
    "records",
    "screenshots",
    "denominators",
    "blocker"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "partial", "blocked"] },
    "producer": { "$ref": "#/$defs/producer" },
    "exactRuntime": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "prefixItems": [
        { "const": "interactive_segmenter/magic_touch" },
        { "const": "Xenova/mobilevit-small" }
      ],
      "items": false,
      "minItems": 2
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "records": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/record" } },
    "screenshots": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/screenshot" }
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeDeviceRuns",
        "consoleBefore",
        "consoleAfter",
        "networkBefore",
        "networkAfter",
        "screenshots"
      ],
      "properties": {
        "routeDeviceRuns": { "$ref": "#/$defs/routeDeviceDenominator" },
        "consoleBefore": { "$ref": "#/$defs/tenDenominator" },
        "consoleAfter": { "$ref": "#/$defs/tenDenominator" },
        "networkBefore": { "$ref": "#/$defs/tenDenominator" },
        "networkAfter": { "$ref": "#/$defs/tenDenominator" },
        "screenshots": { "$ref": "#/$defs/screenshotDenominator" }
      }
    },
    "blocker": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/blocker" }
      ]
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route": { "enum": ["overview", "basics", "practical", "wild", "multi"] },
    "device": { "enum": ["desktop", "mobile"] },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dpr"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "dpr": { "const": 1 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tool",
        "packageVersion",
        "transport",
        "eventCount",
        "ledger",
        "ledgerSha256",
        "finalEventHash"
      ],
      "properties": {
        "name": { "const": "scripts/capture-interactive-segmenter-mcp.mjs" },
        "tool": { "const": "chrome-devtools-mcp" },
        "packageVersion": { "const": "1.6.0" },
        "transport": { "const": "stdio" },
        "eventCount": { "type": "integer", "minimum": 0 },
        "ledger": { "const": "evidence/mcp-events.ndjson" },
        "ledgerSha256": { "$ref": "#/$defs/digest" },
        "finalEventHash": { "$ref": "#/$defs/digest" }
      }
    },
    "routeDeviceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "device", "status"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "device": { "$ref": "#/$defs/device" },
        "status": { "enum": ["completed", "blocked", "notRun"] }
      }
    },
    "routeDeviceDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "blocked", "notRun", "expected", "rows"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 10 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 10 },
        "notRun": { "type": "integer", "minimum": 0, "maximum": 10 },
        "expected": { "const": 10 },
        "rows": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/routeDeviceRow" }
        }
      }
    },
    "tenDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "expected"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 10 },
        "expected": { "const": 10 }
      }
    },
    "screenshotDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "blocked", "expected"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0, "maximum": 20 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 20 },
        "expected": { "const": 20 }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "device",
        "theme",
        "path",
        "expectedViewport",
        "image",
        "bytes",
        "sha256"
      ],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "device": { "$ref": "#/$defs/device" },
        "theme": { "enum": ["light", "dark"] },
        "path": { "type": "string", "pattern": "^evidence/screenshots/[a-z0-9-]+\\.webp$" },
        "expectedViewport": { "$ref": "#/$defs/viewport" },
        "image": { "$ref": "#/$defs/dimensions" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "opacity", "view"],
      "properties": {
        "threshold": { "type": ["string", "null"] },
        "opacity": { "type": ["string", "null"] },
        "view": { "type": ["string", "null"] }
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "ua",
        "viewport",
        "mobileLayout",
        "status",
        "coverage",
        "pointConfidence",
        "shape",
        "selectedPixels",
        "loaders",
        "classificationRows",
        "overflow",
        "controls"
      ],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "ua": { "type": "string", "minLength": 1 },
        "viewport": { "$ref": "#/$defs/viewport" },
        "mobileLayout": { "type": "boolean" },
        "status": { "type": "string" },
        "coverage": { "type": "string" },
        "pointConfidence": { "type": "string" },
        "shape": { "type": "string" },
        "selectedPixels": { "type": "string" },
        "loaders": { "type": "array", "items": { "type": "string" } },
        "classificationRows": { "type": "integer", "minimum": 0 },
        "overflow": { "type": "integer", "minimum": 0 },
        "controls": { "$ref": "#/$defs/controls" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "device", "expectedViewport", "actual"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "device": { "$ref": "#/$defs/device" },
        "expectedViewport": { "$ref": "#/$defs/viewport" },
        "actual": { "$ref": "#/$defs/actual" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "device",
        "action",
        "tool",
        "code",
        "detail",
        "recoverable",
        "retryDisposition"
      ],
      "properties": {
        "route": {
          "type": ["string", "null"],
          "enum": ["overview", "basics", "practical", "wild", "multi", null]
        },
        "device": { "type": ["string", "null"], "enum": ["desktop", "mobile", null] },
        "action": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean" },
        "retryDisposition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
