{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactive-segmenter-event.schema.json",
  "type": "object",
  "required": [
    "sequence",
    "startedAt",
    "endedAt",
    "route",
    "device",
    "eventType",
    "action",
    "tool",
    "request",
    "response",
    "previousHash",
    "hash"
  ],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "eventType": { "enum": ["mcp-tool", "artifact-binding"] },
    "action": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "request": { "type": "object" },
    "response": {
      "type": "object",
      "required": ["isError", "text"],
      "properties": {
        "isError": { "type": "boolean" },
        "text": { "type": "string" }
      }
    },
    "previousHash": { "$ref": "#/$defs/digest" },
    "hash": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "artifact-binding" } } },
      "then": {
        "properties": {
          "action": { "const": "bind-screenshot-artifact" },
          "tool": { "const": "artifact-binding" },
          "request": {
            "required": ["screenshotEventHash", "artifact"],
            "properties": {
              "screenshotEventHash": { "$ref": "#/$defs/digest" },
              "artifact": {
                "type": "object",
                "required": [
                  "path",
                  "outputPath",
                  "route",
                  "device",
                  "theme",
                  "bytes",
                  "sha256",
                  "image",
                  "viewport"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
