{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactive-segmenter-event.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/mcpToolEvent" },
    { "$ref": "#/$defs/artifactBindingEvent" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route": {
      "type": ["string", "null"],
      "enum": ["overview", "basics", "practical", "wild", "multi", null]
    },
    "device": { "type": ["string", "null"], "enum": ["desktop", "mobile", null] },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isError", "text"],
      "properties": {
        "isError": { "type": "boolean" },
        "text": { "type": "string" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dpr"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "dpr": { "const": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "device",
        "theme",
        "path",
        "outputPath",
        "image",
        "bytes",
        "sha256",
        "viewport"
      ],
      "properties": {
        "route": { "enum": ["overview", "basics", "practical", "wild", "multi"] },
        "device": { "enum": ["desktop", "mobile"] },
        "theme": { "enum": ["light", "dark"] },
        "path": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/$defs/dimensions" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "viewport": { "$ref": "#/$defs/viewport" }
      }
    },
    "commonProperties": {
      "sequence": { "type": "integer", "minimum": 1 },
      "startedAt": { "type": "string", "format": "date-time" },
      "endedAt": { "type": "string", "format": "date-time" },
      "route": { "$ref": "#/$defs/route" },
      "device": { "$ref": "#/$defs/device" },
      "action": { "type": "string", "minLength": 1 },
      "tool": { "type": "string", "minLength": 1 },
      "previousHash": { "$ref": "#/$defs/digest" },
      "hash": { "$ref": "#/$defs/digest" }
    },
    "mcpToolEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "startedAt",
        "endedAt",
        "route",
        "device",
        "eventType",
        "action",
        "tool",
        "request",
        "response",
        "previousHash",
        "hash"
      ],
      "properties": {
        "sequence": { "$ref": "#/$defs/commonProperties/sequence" },
        "startedAt": { "$ref": "#/$defs/commonProperties/startedAt" },
        "endedAt": { "$ref": "#/$defs/commonProperties/endedAt" },
        "route": { "$ref": "#/$defs/route" },
        "device": { "$ref": "#/$defs/device" },
        "eventType": { "const": "mcp-tool" },
        "action": { "$ref": "#/$defs/commonProperties/action" },
        "tool": { "type": "string", "minLength": 1, "not": { "const": "artifact-binding" } },
        "request": { "type": "object" },
        "response": { "$ref": "#/$defs/response" },
        "previousHash": { "$ref": "#/$defs/digest" },
        "hash": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactBindingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "startedAt",
        "endedAt",
        "route",
        "device",
        "eventType",
        "action",
        "tool",
        "request",
        "response",
        "previousHash",
        "hash"
      ],
      "properties": {
        "sequence": { "$ref": "#/$defs/commonProperties/sequence" },
        "startedAt": { "$ref": "#/$defs/commonProperties/startedAt" },
        "endedAt": { "$ref": "#/$defs/commonProperties/endedAt" },
        "route": { "enum": ["overview", "basics", "practical", "wild", "multi"] },
        "device": { "enum": ["desktop", "mobile"] },
        "eventType": { "const": "artifact-binding" },
        "action": { "const": "bind-screenshot-artifact" },
        "tool": { "const": "artifact-binding" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshotEventHash", "artifact"],
          "properties": {
            "screenshotEventHash": { "$ref": "#/$defs/digest" },
            "artifact": { "$ref": "#/$defs/artifact" }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isError", "text"],
          "properties": {
            "isError": { "const": false },
            "text": { "const": "" }
          }
        },
        "previousHash": { "$ref": "#/$defs/digest" },
        "hash": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
