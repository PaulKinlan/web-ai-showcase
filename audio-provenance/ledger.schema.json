{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PaulKinlan/web-ai-showcase/audio-provenance/ledger.schema.json",
  "title": "web-ai-showcase site-wide audio provenance ledger",
  "type": "object",
  "required": [
    "name",
    "version",
    "generated",
    "policy",
    "legacyBaseline",
    "totals",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "generated": { "type": "string", "format": "date" },
    "policy": { "type": "array", "items": { "type": "string" } },
    "legacyBaseline": {
      "type": "object",
      "description": "The frozen legacy declaration. Assets bundled at `sha` had no rights record when this gate was introduced; their content hashes are listed explicitly (never a filename pattern) and the legacy set can only shrink. Declaring a content hash that is not listed here as legacy-unreconciled FAILS the gate.",
      "required": ["sha", "note", "bundledFiles", "unreconciledContentHashes", "hashes"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "note": { "type": "string", "minLength": 1 },
        "bundledFiles": { "type": "integer", "minimum": 0 },
        "unreconciledContentHashes": { "type": "integer", "minimum": 0 },
        "hashes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "totals": { "type": "object" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hash",
          "bytes",
          "fileCount",
          "archetype",
          "rightsCleared",
          "evidence",
          "paths"
        ],
        "properties": {
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "fileCount": { "type": "integer", "minimum": 1 },
          "archetype": {
            "enum": ["licensed", "first-party", "legacy-unreconciled"],
            "description": "licensed = third-party audio with a rights record; first-party = generated for this project; legacy-unreconciled = bundled before this gate, no rights record, frozen in legacyBaseline.hashes."
          },
          "rightsCleared": { "type": "boolean" },
          "provenance": {
            "type": "object",
            "description": "Required when rightsCleared is true. kind + license are always required; the gate additionally requires a traceable source (sourceUrl or sourceAsset) and a non-empty attribution.",
            "required": ["kind", "license"],
            "properties": {
              "kind": { "enum": ["licensed", "first-party"] },
              "sourceAsset": { "type": "string" },
              "source": { "type": "string" },
              "sourceUrl": { "type": "string" },
              "creator": { "type": "string" },
              "license": { "type": "string" },
              "licenseName": { "type": "string" },
              "attribution": { "type": "string" }
            }
          },
          "legacyReason": {
            "type": "string",
            "description": "Required when archetype is legacy-unreconciled: why these bytes ship with no rights record."
          },
          "evidence": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
